---
import profilesRaw from "../data/profiles.json";
import masterCVRaw from "../data/master-cv.json";
import type { MasterCV } from "../types/cv";
import fs from "node:fs";
import path from "node:path";

const masterCV = masterCVRaw as MasterCV;

// Get all profiles images from public/images/profiles
const profilePicsDir = path.join(process.cwd(), "public", "images", "profiles");
let profilePics: string[] = [];
try {
  if (!fs.existsSync(profilePicsDir)) {
    fs.mkdirSync(profilePicsDir, { recursive: true });
  }
  profilePics = fs
    .readdirSync(profilePicsDir)
    .filter((file) => /\.(jpg|jpeg|png|webp|avif|svg)$/i.test(file));
} catch (e) {
  console.error("Error reading profile pics:", e);
}

// Get all unique tags from the master CV for the UI
const allTags = new Set<string>();
masterCV.experience.forEach((job) => {
  job.highlights.forEach((h) => h.tags.forEach((t) => allTags.add(t)));
});
masterCV.projects.forEach((p) => p.tags.forEach((t) => allTags.add(t)));
masterCV.education.forEach((e) => e.tags.forEach((t) => allTags.add(t)));
masterCV.skills.forEach((s) => s.tags.forEach((t) => allTags.add(t)));
masterCV.achievements.forEach((a) => a.tags.forEach((t) => allTags.add(t)));
const tagsArray = Array.from(allTags);
const profiles = profilesRaw as {
  title: string;
  tags: string[];
  slug: string;
}[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Resume Engine Dashboard</title>
    <link rel="stylesheet" href="styles/main.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Resume Engine 🚀</h1>
        <p>Select a tag-profile to generate a specific version of your CV.</p>

        <div class="theme-selector">
          <button
            class="theme-btn active"
            data-theme="classic"
            onclick="setTheme('classic')">Classic</button
          >
          <button
            class="theme-btn"
            data-theme="modern"
            onclick="setTheme('modern')">Modern</button
          >
          <button
            class="theme-btn"
            data-theme="neobrutal"
            onclick="setTheme('neobrutal')">NeoBrutal</button
          >
        </div>

        <div class="lang-selector">
          <button class="lang-btn active" data-lang="en" onclick="setLang('en')"
            >English</button
          >
          <button class="lang-btn" data-lang="th" onclick="setLang('th')"
            >Thai</button
          >
        </div>

        <div class="pfp-section" style="margin-top: 2.5rem;">
          <label
            style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-bottom: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;"
            >Selected Identity</label
          >
          <div
            class="pfp-gallery"
            style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;"
          >
            <div
              class="pfp-item active"
              data-pfp="none"
              onclick="setPFP('none')"
              title="No Profile Picture"
            >
              <div class="pfp-frame">
                <div class="pfp-placeholder">🚫</div>
              </div>
            </div>
            {
              profilePics.map((pic) => (
                <div
                  class="pfp-item"
                  data-pfp={`images/profiles/${pic}`}
                  onclick={`setPFP('images/profiles/${pic}')`}
                  title={pic}
                >
                  <div class="pfp-frame">
                    <img src={`images/profiles/${pic}`} alt={pic} />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="grid">
        {
          profiles.map((profile) => (
            <div class="card">
              <h2>{profile.title}</h2>
              <div class="tags">
                {profile.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <a
                href={`resume/en/classic/${profile.slug}/index.html`}
                class="btn generate-btn"
                data-slug={profile.slug}
              >
                Generate Resume
              </a>
            </div>
          ))
        }
      </div>

      <div class="stats">
        <h3>Master CV Stats</h3>
        <p>
          <strong>Total Items:</strong>
          {masterCV.experience.length} jobs, {masterCV.education.length} edu, {
            masterCV.skills.length
          } skills, {masterCV.achievements.length} achievements
        </p>
        <p><strong>Available Tags:</strong> {tagsArray.sort().join(", ")}</p>
      </div>
    </div>

    <script is:inline>
      let currentTheme = localStorage.getItem("resume-theme") || "classic";
      let currentPFP = localStorage.getItem("resume-pfp") || "none";
      let currentLang = localStorage.getItem("resume-lang") || "en";

      function setTheme(theme) {
        currentTheme = theme;
        document.querySelectorAll(".theme-btn").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.theme === theme);
        });
        updateLinks();
        localStorage.setItem("resume-theme", theme);
      }

      function setLang(lang) {
        currentLang = lang;
        document.querySelectorAll(".lang-btn").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.lang === lang);
        });
        updateLinks();
        localStorage.setItem("resume-lang", lang);
      }

      function setPFP(pfp) {
        currentPFP = pfp;
        document.querySelectorAll(".pfp-item").forEach((item) => {
          item.classList.toggle("active", (item.dataset.pfp || "none") === pfp);
        });
        updateLinks();
        localStorage.setItem("resume-pfp", pfp);
      }

      function updateLinks() {
        document.querySelectorAll(".generate-btn").forEach((btn) => {
          const slug = btn.dataset.slug;
          // Use relative path and append index.html for file:// compatibility
          let href = `resume/${currentLang}/${currentTheme}/${slug}/index.html`;
          if (currentPFP) {
            href += `?pfp=${encodeURIComponent(currentPFP)}`;
          }
          btn.href = href;
        });
      }

      // Initialize items
      setPFP(currentPFP);
      setTheme(currentTheme);
      setLang(currentLang);
    </script>
  </body>
</html>
