---
import profilesRaw from "../data/profiles.json";
import masterCVRaw from "../data/master-cv.json";
import type { MasterCV } from "../types/cv";
import fs from "node:fs";
import path from "node:path";

const masterCV = masterCVRaw as MasterCV;

// Get all profiles images from public/images/profiles
const profilePicsDir = path.join(process.cwd(), "public", "images", "profiles");
let profilePics: string[] = [];
try {
  if (!fs.existsSync(profilePicsDir)) {
    fs.mkdirSync(profilePicsDir, { recursive: true });
  }
  profilePics = fs
    .readdirSync(profilePicsDir)
    .filter((file) => /\.(jpg|jpeg|png|webp|avif|svg)$/i.test(file));
} catch (e) {
  console.error("Error reading profile pics:", e);
}

// Get all unique tags from the master CV for the UI
const allTags = new Set<string>();
masterCV.experience.forEach((job) => {
  job.highlights.forEach((h) => h.tags.forEach((t) => allTags.add(t)));
});
masterCV.projects.forEach((p) => p.tags.forEach((t) => allTags.add(t)));
masterCV.education.forEach((e) => e.tags.forEach((t) => allTags.add(t)));
masterCV.skills.forEach((s) => s.tags.forEach((t) => allTags.add(t)));
masterCV.achievements.forEach((a) => a.tags.forEach((t) => allTags.add(t)));
const tagsArray = Array.from(allTags);
const profiles = profilesRaw as {
  title: string;
  tags: string[];
  slug: string;
}[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Resume Engine Dashboard</title>
    <link rel="stylesheet" href="/src/styles/main.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Resume Engine 🚀</h1>
        <p>Select a tag-profile to generate a specific version of your CV.</p>

        <div class="theme-selector">
          <button
            class="theme-btn active"
            data-theme="classic"
            onclick="setTheme('classic')">Classic</button
          >
          <button
            class="theme-btn"
            data-theme="modern"
            onclick="setTheme('modern')">Modern</button
          >
        </div>

        <div class="pfp-selector" style="margin-top: 1.5rem;">
          <label
            style="color: var(--text-muted); font-size: 0.875rem; margin-right: 1rem; font-weight: 600;"
            >PROFILE PICTURE:</label
          >
          <select
            id="pfp-select"
            onchange="setPFP(this.value)"
            style="background: var(--card-bg); color: var(--text); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: 9999px; outline: none; cursor: pointer; font-weight: 600;"
          >
            <option value="">Default (Master CV)</option>
            {
              profilePics.map((pic) => (
                <option value={`/images/profiles/${pic}`}>{pic}</option>
              ))
            }
          </select>
        </div>
      </div>

      <div class="grid">
        {
          profiles.map((profile) => (
            <div class="card">
              <h2>{profile.title}</h2>
              <div class="tags">
                {profile.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <a
                href={`/resume/classic/${profile.slug}`}
                class="btn generate-btn"
                data-slug={profile.slug}
              >
                Generate Resume
              </a>
            </div>
          ))
        }
      </div>

      <div class="stats">
        <h3>Master CV Stats</h3>
        <p>
          <strong>Total Items:</strong>
          {masterCV.experience.length} jobs, {masterCV.education.length} edu, {
            masterCV.skills.length
          } skills, {masterCV.achievements.length} achievements
        </p>
        <p><strong>Available Tags:</strong> {tagsArray.sort().join(", ")}</p>
      </div>
    </div>

    <script is:inline>
      let currentTheme = localStorage.getItem("resume-theme") || "classic";
      let currentPFP = localStorage.getItem("resume-pfp") || "";

      function setTheme(theme) {
        currentTheme = theme;
        // Update buttons
        document.querySelectorAll(".theme-btn").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.theme === theme);
        });
        updateLinks();
        localStorage.setItem("resume-theme", theme);
      }

      function setPFP(pfp) {
        currentPFP = pfp;
        updateLinks();
        localStorage.setItem("resume-pfp", pfp);
      }

      function updateLinks() {
        document.querySelectorAll(".generate-btn").forEach((btn) => {
          const slug = btn.dataset.slug;
          let href = `/resume/${currentTheme}/${slug}`;
          if (currentPFP) {
            href += `?pfp=${encodeURIComponent(currentPFP)}`;
          }
          btn.href = href;
        });
      }

      // Initialize
      document.getElementById("pfp-select").value = currentPFP;
      setTheme(currentTheme);
    </script>
  </body>
</html>
