---
// ChatWidget.astro
---

<div id="chat-widget-container" class="chat-widget-container">
  <!-- Chat Bubble (Toggle) -->
  <button id="chat-toggle" class="chat-toggle" aria-label="Open Chat">
    <span class="chat-icon">💬</span>
    <span class="close-icon" style="display: none;">✕</span>
  </button>

  <!-- Chat Window -->
  <div id="chat-window" class="chat-window" style="display: none;">
    <div class="chat-header">
      <div class="dot"></div>
      <h2>AI Support</h2>
      <span class="subtitle">Powered by Llama 3.1</span>
    </div>

    <div class="chat-messages" id="messages">
      <div class="welcome">
        <div class="emoji">💬</div>
        <p>Hi there! Ask me anything about our products and services.</p>
      </div>
    </div>

    <div class="chat-input">
      <input
        type="text"
        id="user-input"
        placeholder="Ask us anything..."
        autocomplete="off"
      />
      <button id="send-btn">Send</button>
    </div>
  </div>
</div>

<style>
  /* Container for fixed positioning */
  .chat-widget-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    font-family: "Inter", system-ui, -apple-system, sans-serif;
  }

  /* Toggle Button */
  .chat-toggle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6d28d9 0%, #4f46e5 100%);
    border: none;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
    color: white;
    font-size: 1.5rem;
  }

  .chat-toggle:hover {
    transform: scale(1.05);
  }

  .chat-toggle:active {
    transform: scale(0.95);
  }

  /* Chat Window */
  .chat-window {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 350px;
    height: 500px;
    background: rgba(24, 24, 32, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideUp 0.3s ease-out;
    transform-origin: bottom right;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Header */
  .chat-header {
    padding: 1rem;
    background: linear-gradient(135deg, #6d28d9 0%, #4f46e5 100%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: white;
  }

  .chat-header .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 8px #34d399aa;
  }

  .chat-header h2 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0;
  }

  .chat-header .subtitle {
    font-size: 0.7rem;
    opacity: 0.8;
    margin-left: auto;
  }

  /* Messages */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .msg {
    max-width: 80%;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    font-size: 0.85rem;
    line-height: 1.4;
    word-wrap: break-word;
  }

  .msg.user {
    align-self: flex-end;
    background: #4f46e5;
    color: white;
    border-bottom-right-radius: 2px;
  }

  .msg.bot {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.1);
    color: #e4e4e7;
    border-bottom-left-radius: 2px;
  }

  .msg.bot.error {
    background: rgba(220, 38, 38, 0.2);
    color: #fca5a5;
  }

  /* Typing */
  .typing {
    display: flex;
    gap: 4px;
    padding: 0.5rem;
    align-self: flex-start;
  }
  .typing span {
    width: 6px;
    height: 6px;
    background: rgba(255,255,255,0.4);
    border-radius: 50%;
    animation: bounce 1.4s infinite;
  }
  .typing span:nth-child(2) { animation-delay: 0.2s; }
  .typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }

  /* Input */
  .chat-input {
    padding: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    gap: 0.5rem;
  }

  .chat-input input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    padding: 0.5rem;
    border-radius: 8px;
    outline: none;
  }

  .chat-input button {
    background: #4f46e5;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }

  /* Welcome */
  .welcome {
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    margin-top: 1rem;
  }
  .welcome .emoji { font-size: 1.5rem; margin-bottom: 0.5rem; }
</style>

<script>
  const toggleBtn = document.getElementById("chat-toggle");
  const chatWindow = document.getElementById("chat-window");
  const chatIcon = toggleBtn.querySelector(".chat-icon") as HTMLElement;
  const closeIcon = toggleBtn.querySelector(".close-icon") as HTMLElement;
  const messagesDiv = document.getElementById("messages");
  const inputEl = document.getElementById("user-input") as HTMLInputElement;
  const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;

  let isOpen = false;
  let isFirstMessage = true;

  toggleBtn.addEventListener("click", () => {
    isOpen = !isOpen;
    if (isOpen) {
      chatWindow.style.display = "flex";
      chatIcon.style.display = "none";
      closeIcon.style.display = "inline";
      setTimeout(() => inputEl.focus(), 100);
    } else {
      chatWindow.style.display = "none";
      chatIcon.style.display = "inline";
      closeIcon.style.display = "none";
    }
  });

  inputEl.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  sendBtn.addEventListener("click", sendMessage);

  async function sendMessage() {
    const userMessage = inputEl.value.trim();
    if (!userMessage) return;

    if (isFirstMessage) {
      messagesDiv.innerHTML = "";
      isFirstMessage = false;
    }

    // Add user message
    appendMessage(userMessage, "user");
    inputEl.value = "";
    sendBtn.disabled = true;

    // Typing indicator
    const typingEl = document.createElement("div");
    typingEl.className = "typing";
    typingEl.innerHTML = "<span></span><span></span><span></span>";
    messagesDiv.appendChild(typingEl);
    messagesDiv.scrollTop = messagesDiv.scrollHeight;

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: userMessage }),
      });

      const data = await res.json();
      typingEl.remove();

      if (!res.ok) {
        appendMessage(data.error || "Error", "bot error");
      } else {
        appendMessage(data.response, "bot");
      }
    } catch (err) {
      typingEl.remove();
      appendMessage("Network error", "bot error");
    }

    sendBtn.disabled = false;
    inputEl.focus();
  }

  function appendMessage(text: string, className: string) {
    const el = document.createElement("div");
    el.className = `msg ${className}`;
    el.textContent = text;
    messagesDiv.appendChild(el);
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }
</script>
